{
  "name": "rugdealer-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "smoke": "vitest run --config vitest.testnet.config.ts",
    "predev": "npm run sync-deployment",
    "prebuild": "npm run sync-deployment",
    "pretest": "npm run sync-deployment",
    "pretypecheck": "npm run sync-deployment",
    "presmoke": "npm run sync-deployment",
    "sync-deployment": "node scripts/sync-deployment.mjs"
  },
  "dependencies": {
    "@stellar/freighter-api": "6.0.1",
    "@stellar/stellar-sdk": "17.4.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
